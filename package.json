{
  "name": "apr-pt-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @apr/api\" \"npm run dev -w @apr/web\"",
    "build": "npm run build -w @apr/api && npm run build -w @apr/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev:database": "tsx scripts/local-postgres.ts",
    "setup:local": "tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "concurrently": "^9.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "js-yaml": "5.4.3"
  },
  "packageManager": "npm@11.19.0"
}
